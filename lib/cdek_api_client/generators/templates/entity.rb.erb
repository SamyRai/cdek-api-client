# frozen_string_literal: true

require_relative 'validatable'
<%- requires.each do |req| -%>
require_relative '<%= req %>'
<%- end -%>

module CDEKApiClient
  module Entities
    # Auto-generated by EntityGenerator based on CDEK OpenAPI Schema
    class <%= class_name %>
      include Validatable

      attr_accessor <%= properties.keys.map { |k| ":#{k}" }.join(', ') %>

<%- properties.each do |k, prop| -%>
      validates :<%= k %>, type: :<%= ruby_type(prop) %><%= required_fields.include?(k.to_s) ? ', presence: true' : '' %><%= items_validation(prop) %>
<%- end -%>

      # Initializes a new <%= class_name %> object.
<%- properties.each do |k, prop| -%>
      # @param <%= k %> [<%= yard_type(prop) %>]
<%- end -%>
      def initialize(<%= initialize_args(properties, required_fields) %>)
<%- properties.keys.each do |k| -%>
        @<%= k %> = <%= k %>
<%- end -%>
        validate!
      end

      # Converts the object to a JSON representation.
      def to_json(*_args)
        {
<%- properties.keys.each do |k| -%>
          <%= k %>: @<%= k %>,
<%- end -%>
        }.reject { |_, v| v.nil? }.to_json
      end
    end
  end
end
