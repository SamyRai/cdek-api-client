# frozen_string_literal: true

require 'dry-struct'
require_relative 'types'
<%- requires.each do |req| -%>
require_relative '<%= req %>'
<%- end -%>

module CDEKApiClient
  module Entities
    # Auto-generated by EntityGenerator based on CDEK OpenAPI Schema
    class <%= class_name %> < Dry::Struct
      transform_keys(&:to_sym)

<%- properties.each do |k, prop| -%>
      # @!attribute [r] <%= k %>
      #   @return [<%= yard_type(prop) %>]
      attribute? :<%= k %>, <%= dry_type(prop) %>
<%- end -%>

      # Converts the object to a hash representation suitable for API requests.
      def to_h
        super.reject { |_, v| v.nil? }
      end

      # Converts the object to a JSON representation.
      def to_json(*_args)
        to_h.to_json
      end
    end
  end
end
